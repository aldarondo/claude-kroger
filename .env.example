# Kroger Developer API credentials
# Create an app at https://developer.kroger.com/dashboard/
KROGER_CLIENT_ID=your_client_id_here
KROGER_CLIENT_SECRET=your_client_secret_here

# Optional redirect URI (default: http://localhost:8767/callback)
# KROGER_REDIRECT_URI=http://localhost:8767/callback

# User tokens — set automatically by `node src/authorize.js`
# Required for cart operations (add_to_cart tool)
KROGER_USER_TOKEN=
KROGER_USER_REFRESH_TOKEN=
KROGER_USER_TOKEN_EXPIRES_AT=
